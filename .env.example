APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
# Banco — mesmo padrão dos sistemas CHS (Gestão de Notas, Gestão Financeira...)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lexcloud
DB_USER=lexcloud
DB_PASS=troque-esta-senha
# TiDB: DB_SSL=true e DB_PORT=4000 (hosts *.tidbcloud.com já ligam o TLS sozinhos). Local: false
DB_SSL=false
# Ainda aceitos, por compatibilidade: DATABASE_URL e MYSQL_HOST/MYSQL_PORT/MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD
MAX_UPLOAD_BYTES=12582912

# Atrás do proxy do Render/Fly: true (IP real no bloqueio de login e na auditoria). Local: false
TRUST_PROXY=false
# Endereço público (links dos e-mails de convite e de senha), sem barra no fim
APP_URL=http://127.0.0.1:3000
# Cria/atualiza as tabelas ao iniciar o container (Render gratuito). Local: rode php bin/migrate.php
RUN_MIGRATIONS=false
# Autocadastro público de escritórios (padrão: desligado — o admin da plataforma cadastra)
ALLOW_SIGNUP=false
# Criação do admin da plataforma pela web (/#/instalar): 24+ caracteres; apague depois
SETUP_TOKEN=
# E-mail (convites e recuperação de senha)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=LexCloud

# Só se o log do Render apontar erro de CERTIFICADO ao conectar no TiDB: false mantém a conexão criptografada,
# mas não confere o certificado do servidor. O padrão (vazio) confere.
DB_SSL_VERIFY=

# ── Acesso inicial (bin/seed.php, roda sozinho junto com a migração) ──
# Senha inicial das contas criadas pela plataforma (admin, responsáveis dos escritórios, demo).
# Troca obrigatória no primeiro acesso; vale 7 dias. Vazia = "password". Recomendado: um valor só seu.
SENHA_PADRAO=
# Seu acesso de admin da plataforma (criado só se ainda não existir nenhum)
ADMIN_USUARIO=cleiton.santos
ADMIN_EMAIL=cleiton@chsconsultoria.com.br
ADMIN_NOME=Cleiton Santos
# Esqueceu a senha do admin? true devolve o admin existente ao ADMIN_USUARIO com a SENHA_PADRAO. APAGUE depois.
ADMIN_REDEFINIR=false
# Escritório de demonstração com dados fictícios (usuário "demo"). false = não criar.
DEMO_DATA=true
